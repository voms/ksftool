<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="KsfCompanion.App"
             Name="KSF Companion"
             RequestedThemeVariant="Dark">
    <Application.Styles>
        <FluentTheme>
            <FluentTheme.Palettes>
                <ColorPaletteResources x:Key="Dark" Accent="#FF7A1A" RegionColor="#07070A" />
            </FluentTheme.Palettes>
        </FluentTheme>
        <StyleInclude Source="avares://ksf-companion/Ui/Theme.axaml" />
    </Application.Styles>
</Application>
