<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>ksf-companion</AssemblyName>
    <RootNamespace>KsfCompanion</RootNamespace>
    <Version>3.2.1</Version>
    <Product>KSF Companion</Product>
    <Description>KSF surf dashboard for your second monitor, plus in-game map info and a play-later list for CS:S - for Linux.</Description>
    <!-- Numbers and dates are always written the same way (1,234 - Sep 27), and no ICU is needed at run time. -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.22" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.22" />
    <!-- Renders the dashboard to a PNG without a display (the preview command, and the UI self-test). -->
    <PackageReference Include="Avalonia.Headless" Version="11.3.22" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Ui\Assets\Fonts\*.ttf" />
    <AvaloniaResource Include="Ui\Assets\icon-*.png" />
  </ItemGroup>

</Project>
